<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Enum members and JS-interop plumbing are self-describing; only the API surface a
         consumer configures is documented. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TwelveColumns</PackageId>
    <Version>1.0.0</Version>
    <Authors>cmoussalli</Authors>
    <Description>A Grafana-style 12-column drag-and-drop dashboard canvas for Blazor. Widgets can be added, moved, resized and removed by the end user; the layout is plain C# data the host app owns.</Description>
    <PackageTags>blazor;dashboard;grid;drag-and-drop;widgets;layout;grafana</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/cmoussalli/12Columns</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
