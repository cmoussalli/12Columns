@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="brand" href="">
            <span class="brand-mark" aria-hidden="true">
                @for (var i = 0; i < 4; i++)
                {
                    <i></i>
                }
            </span>
            <span class="brand-text">TwelveColumns</span>
        </a>
        <NavMenu />
        <a class="app-header-link" href="https://github.com/cmoussalli/12Columns" target="_blank" rel="noopener">GitHub</a>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
